{
  "name": "dantonio-pi-meter",
  "version": "0.4.0",
  "description": "One subtle line above the Pi editor: session token totals (orchestrator + settled subagents), live/session tokens per second, and subscription usage sources for the alt+u panel (torogoz, OpenCode Go, OpenRouter, custom).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "gentle-shell-extension",
    "gentle-shell-package",
    "pi-coding-agent",
    "pi-package",
    "subscription-usage",
    "tokens",
    "tps",
    "usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dantoniomarte/dantonio-pi-meter.git"
  },
  "bugs": {
    "url": "https://github.com/dantoniomarte/dantonio-pi-meter/issues"
  },
  "homepage": "https://github.com/dantoniomarte/dantonio-pi-meter#readme",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/meter.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
